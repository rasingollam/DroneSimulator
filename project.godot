config_version=5

[application]
config/name="Vector — Flight Lab"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/description="A physics-based quadcopter training field."

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]
common/physics_ticks_per_second=240
3d/default_gravity=9.80665
3d/solver/contact_max_allowed_penetration=0.0005
3d/solver/solver_iterations=32

[rendering]
anti_aliasing/quality/msaa_3d=1
textures/default_filters/anisotropic_filtering_level=3
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.53, 0.68, 0.76, 1)
